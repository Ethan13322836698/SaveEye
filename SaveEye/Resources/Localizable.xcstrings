        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否需要延迟休息？按ESC延迟%@"
          }
        }
      }
    },
    "exit.delay_after" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
