    "permission.accessibility.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SaveEye needs Accessibility permission to monitor your activity and provide eye care reminders."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SaveEye はユーザーの操作を監視して目の休憩リマインダーを提供するため、アクセシビリティ権限が必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SaveEye 需要辅助功能权限来监控您的活动并提供护眼提醒。"
          }
        }
      }
    },
