    "settings.break_interval.recommendation" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "20-30 min is recommended to reduce eye fatigue"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "20-30分に設定すると目の疲れを軽減できます"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建议设置为 20-30 分钟，有效缓解眼部疲劳"
          }
        }
      }
    },
